{
  "manifest_version": 3,
  "name": "Live Translate Subtitles",
  "version": "0.0.0",
  "description": "Local-first real-time translated subtitles for browser media.",
  "key": "",
  "permissions": ["activeTab", "nativeMessaging", "offscreen", "scripting", "storage", "tabCapture"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
